{
  "name": "kindling",
  "version": "0.0.0",
  "private": true,
  "description": "An opinionated launchpad for building products on Cloudflare.",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy --yes",
    "destroy": "alchemy destroy --yes",
    "plan": "alchemy plan",
    "logs": "alchemy logs",
    "tail": "alchemy tail",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "commits:lint": "./scripts/check-commit-messages.sh",
    "commit:lint": "./scripts/check-commit-message.sh",
    "check": "bun run typecheck && bun run lint && bun run fmt:check"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.72",
    "@better-auth/api-key": "1.6.27",
    "@effect/platform-bun": "^4.0.0-rc.108",
    "@effect/platform-node": "^4.0.0-rc.108",
    "@effect/platform-node-shared": "^4.0.0-rc.108",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "alchemy": "2.0.0-beta.72",
    "better-auth": "1.6.27",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.7"
  }
}
